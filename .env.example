# MongoDB Atlas (admin login + blogs). Add the same variables in Vercel → Project → Settings → Environment Variables.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=promonex

# Random secret (min 32 chars) used to sign admin sessions, e.g.:
#   node -e "console.log(require(crypto).randomBytes(48).toString(base64url))"
AUTH_SECRET=

# Optional: only if your network cannot resolve mongodb+srv DNS records
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
